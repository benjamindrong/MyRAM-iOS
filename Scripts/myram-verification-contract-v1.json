    {
      "id": "F02",
      "definition": "A changed area, verification obligation, or evidence obligation cannot be mapped to explicit authority.",
      "definition_authority_id": "A-FAIL"
    },
    {
      "id": "F03",
      "definition": "Authoritative inputs conflict without explicit precedence.",
      "definition_authority_id": "A-FAIL"
    },
    {
      "id": "F04",
      "definition": "Source/test state changes after the candidate is frozen or verification begins without regeneration/restart.",
