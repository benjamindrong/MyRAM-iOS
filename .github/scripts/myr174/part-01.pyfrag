enum SyncBatchEnvelopeCodec {
    static func encode(batch: SyncBatch) throws -> Data {
        let envelope = try SyncBatchEnvelope(validating: batch)
        let encoder = JSONEncoder()
        if envelope.schemaVersion == .v2 {
