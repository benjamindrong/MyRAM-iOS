
    private func withSchema(_ schema: Int, data: Data) throws -> Data {{
        var object = try XCTUnwrap(try JSONSerialization.jsonObject(with: data) as? [String: Any])
        object["schemaVersion"] = schema
        return try JSONSerialization.data(withJSONObject: object)
    }}

    private func mixedFixtureData() throws -> Data {{
        var anchored = try XCTUnwrap(try JSONSerialization.jsonObject(with: SyncBatchEnvelopeCodec.encode(batch: anchoredBatch())) as? [String: Any])
        let legacy = try XCTUnwrap(try JSONSerialization.jsonObject(with: SyncBatchEnvelopeCodec.encode(batch: legacyBatch())) as? [String: Any])
        var anchoredBatch = try XCTUnwrap(anchored["batch"] as? [String: Any])
        let legacyBatch = try XCTUnwrap(legacy["batch"] as? [String: Any])
        var changes = try XCTUnwrap(anchoredBatch["changes"] as? [[String: Any]])
        let legacyChanges = try XCTUnwrap(legacyBatch["changes"] as? [[String: Any]])
        changes.append(try XCTUnwrap(legacyChanges.first))
        anchoredBatch["changes"] = changes
        anchored["batch"] = anchoredBatch
        return try JSONSerialization.data(withJSONObject: anchored)
    }}

    private func assertMismatch(
        data: Data,
        schema: SyncBatchEnvelopeSchemaVersion,
        representation: SyncBatchBodyOperationRepresentation
    ) throws {{
        XCTAssertThrowsError(try SyncBatchEnvelopeCodec.decode(data)) {{
            XCTAssertEqual(
                $0 as? SyncBatchEnvelopeError,
                .representationMismatch(schema: schema, representation: representation)
            )
        }}
    }}

    private func jsonObject(_ data: Data) throws -> NSDictionary {{
        try XCTUnwrap(try JSONSerialization.jsonObject(with: data) as? NSDictionary)
    }}
}}
