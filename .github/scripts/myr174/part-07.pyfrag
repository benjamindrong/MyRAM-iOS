        build_anchor.group(1) + f"\n\t\t{build_id} /* {name} in Sources */ = {{isa = PBXBuildFile; fileRef = {file_id} /* {name} */; }};",
        1,
    )

    file_anchor = re.search(
        rf"^(\s*[A-F0-9]{{24}} /\* {re.escape(anchor_name)} \*/ = \{{isa = PBXFileReference;[^\n]+\}};)$",
        pbx,
        re.MULTILINE,
    )
    if not file_anchor:
        raise RuntimeError(f"Missing PBXFileReference anchor for {anchor_name}")
    relative_path = Path(path).name
    pbx = pbx.replace(
        file_anchor.group(1),
        file_anchor.group(1) + f"\n\t\t{file_id} /* {name} */ = {{isa = PBXFileReference; lastKnownFileType = sourcecode.swift; path = {relative_path}; sourceTree = \"<group>\"; }};",
        1,
    )

    group_anchor = re.search(
        rf"^(\s*[A-F0-9]{{24}} /\* {re.escape(anchor_name)} \*/,)$",
        pbx,
        re.MULTILINE,
    )
    if not group_anchor:
        raise RuntimeError(f"Missing group anchor for {anchor_name}")
    pbx = pbx.replace(
        group_anchor.group(1),
        group_anchor.group(1) + f"\n\t\t\t\t{file_id} /* {name} */,",
        1,
    )

    source_anchor = re.search(
        rf"^(\s*[A-F0-9]{{24}} /\* {re.escape(anchor_name)} in Sources \*/,)$",
        pbx,
        re.MULTILINE,
    )
    if not source_anchor:
        raise RuntimeError(f"Missing sources-phase anchor for {anchor_name}")
    pbx = pbx.replace(
        source_anchor.group(1),
        source_anchor.group(1) + f"\n\t\t\t\t{build_id} /* {name} in Sources */,",
        1,
    )

write(pbx_path, pbx)

# Static scope/API audits before the workflow commits.
for path in [
    "MyRAM/Sync/MyRAMSyncController.swift",
    "MyRAM/Mac/Sync/MacSyncBatchController.swift",
]:
    text = read(path)
    if "encodeBatchEnvelope" in text:
        raise RuntimeError(f"Legacy batch encoder remains in {path}")
    if "decode(SyncBatchEnvelope.self" in text:
        raise RuntimeError(f"Direct batch envelope decode remains in {path}")
    if "encodeBatch(batch)" not in text or "decodeBatchPayload(message.payload)" not in text:
        raise RuntimeError(f"Exact codec migration missing in {path}")

for path in ROOT.rglob("*.swift"):
    text = path.read_text()
    if "SyncBatchEnvelope(schemaVersion:" in text:
        raise RuntimeError(f"Schema-selecting initializer call remains in {path}")
    if "encodeBatchEnvelope" in text:
        raise RuntimeError(f"Legacy batch encoder call remains in {path}")
    if "canDecodeWithCurrentSchema" in text and path.name != "MultipeerSyncMessageEnvelope.swift":
        raise RuntimeError(f"Legacy inner-envelope compatibility check remains in {path}")

if "static let isEnabled = false" not in read("MyRAM/Sync/Batch/SyncBatchAnchoredPayloadPolicy.swift"):
    raise RuntimeError("Anchored capability changed")
